# Frontend Vite: opcional. Se vazio, o app usa a API no mesmo dominio em /api.
VITE_API_URL=

# Backend/API: nunca use prefixo VITE_ em segredos.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/conecta_saude_olinda
DATABASE_SSL=false
JWT_SECRET=troque-por-um-segredo-forte-com-no-minimo-32-caracteres
PORT=4173
CORS_ORIGIN=http://localhost:3000,http://localhost:4173

# Admin inicial opcional para ambientes novos.
INITIAL_ADMIN_MATRICULA=ADMIN001
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte-de-desenvolvimento
